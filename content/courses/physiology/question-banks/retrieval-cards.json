        "physiology-7-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "physiology-7-card-2",
      "lesson_id": "physiology-7",
      "front": "Along a capillary",
      "back": "Net pressure falls with P_c; many tissues filter along most of the length, with lymph returning fluid.",
