        "physiology-7-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "physiology-7-card-3",
      "lesson_id": "physiology-7",
      "front": "Edema routes",
      "back": "Higher P_c, lower π_c, leaky walls (lower σ, higher K_f) or blocked lymph.",
