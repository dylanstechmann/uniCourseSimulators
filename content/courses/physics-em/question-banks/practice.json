    {
      "id": "physics-em-4:electrode-polarization",
      "type": "single_choice",
      "prompt": "After attaching a skin electrode, a recorded trace shows a slow baseline shift that decays over minutes and does not follow the subject's activity. What is the most likely origin?",
      "options": [
        "A large tissue signal at very low frequency.",
        "The amplifier's gain being too high only.",
        "Electrode half-cell polarization and settling, not tissue signal.",
        "The subject's heartbeat."
      ],
      "points": 1,
      "objective_ids": [
        "physics-em-4-objective-2"
      ],
      "solution_spec": {
        "answer": 2
      },
      "feedback": {
        "hint": "Separate drifts that follow the preparation from signals that follow the physiology.",
        "solution": "A slow drift after placement that decays and is unrelated to activity is typical of electrode polarization and skin-interface settling. Choosing stable electrode materials, allowing settling time and high-pass filtering carefully separate it from low-frequency tissue signal.",
        "lesson_ids": [
          "physics-em-4"
        ],
        "misconception_ids": []
      },
