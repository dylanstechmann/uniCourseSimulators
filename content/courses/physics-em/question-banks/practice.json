    {
      "id": "physics-em-2:rc-charging",
      "type": "numeric",
      "prompt": "A 5.0 V source charges a 1.0 kΩ and 1.0 µF series RC circuit from zero. Calculate the capacitor voltage at t = 2.0 ms. Enter a value and unit.",
      "points": 1,
      "objective_ids": [
        "physics-em-2-objective-2"
      ],
      "solution_spec": {
        "answer": 4.323,
        "unit": "V",
        "tolerance": 0.01,
        "unit_required": true,
        "significant_figures": null,
        "dimensions": null
      },
      "feedback": {
        "hint": "The time constant is RC.",
        "solution": "RC = 10³ Ω × 10⁻⁶ F = 1.0 ms, so V(2 ms) = 5.0 (1 − e⁻²) = 4.32 V. After about five time constants the capacitor is within 1% of the source.",
        "lesson_ids": [
          "physics-em-2"
        ],
        "misconception_ids": []
      },
      "visibility": "public-practice-authoring",
      "provenance": {
        "kind": "original",
