        "tolerance": 0.01,
        "unit_required": false,
        "significant_figures": null,
        "dimensions": null
      },
      "feedback": {
        "hint": "Set ∇f = λ∇g with g = x + y.",
        "solution": "∇f = (y, x) = λ(1, 1) gives x = y, and the constraint gives x = y = 5, so f = 25. The constraint is smooth and the critical point is a maximum along it.",
        "lesson_ids": [
          "calculus-3-2"
        ],
        "misconception_ids": []
      },
      "visibility": "public-practice-authoring",
      "provenance": {
        "kind": "original",
