    {
      "id": "calculus-3-1:directional-derivative",
      "type": "numeric",
      "prompt": "For f(x, y) = x²y at the point (1, 2), calculate the directional derivative in the direction of the vector (3, 4). Enter a number.",
      "points": 1,
      "objective_ids": [
        "calculus-3-1-objective-2"
      ],
      "solution_spec": {
        "answer": 3.2,
        "unit": "",
        "tolerance": 0.01,
        "unit_required": false,
        "significant_figures": null,
        "dimensions": null
      },
      "feedback": {
        "hint": "Use the gradient and a unit direction vector.",
        "solution": "∇f = (2xy, x²) = (4, 1) at (1, 2). The unit vector is (3, 4)/5, so the directional derivative is (4·3 + 1·4)/5 = 3.2.",
        "lesson_ids": [
          "calculus-3-1"
        ],
        "misconception_ids": []
      },
      "visibility": "public-practice-authoring",
      "provenance": {
        "kind": "original",
        "modifications": []
      }
    },
    {
      "id": "calculus-3-2:lagrange-multiplier",
      "type": "numeric",
      "prompt": "Maximize f(x, y) = xy subject to x + y = 10. Enter the maximum value.",
      "points": 1,
