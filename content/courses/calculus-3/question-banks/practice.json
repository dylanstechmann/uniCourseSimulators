    {
      "id": "calculus-3-4:check",
      "type": "single_choice",
      "prompt": "Which theorem relates outward flux across a closed surface to the volume integral of divergence?",
      "options": [
        "Fundamental theorem of calculus",
        "Divergence theorem",
        "Chain rule",
        "Mean value theorem"
      ],
      "points": 1,
      "objective_ids": [
        "calculus-3-4-objective-1"
      ],
      "solution_spec": {
        "answer": 1
      },
      "feedback": {
        "hint": "This theorem connects a closed boundary to the volume it encloses.",
        "solution": "The divergence theorem states that outward flux through a closed surface equals the volume integral of divergence over its interior.",
        "lesson_ids": [
          "calculus-3-4"
        ],
        "misconception_ids": []
      },
      "visibility": "public-practice-authoring",
