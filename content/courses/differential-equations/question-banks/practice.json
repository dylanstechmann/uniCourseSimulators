    {
      "id": "differential-equations-3:check",
      "type": "single_choice",
      "prompt": "A two-state continuous system has Jacobian eigenvalues −2 and +0.1 at an equilibrium. What can be concluded locally?",
      "options": [
        "The equilibrium is asymptotically stable",
        "The equilibrium is unstable",
        "The system is periodic",
        "The equilibrium is globally stable"
      ],
      "points": 1,
      "objective_ids": [
        "differential-equations-3-objective-1"
      ],
      "solution_spec": {
        "answer": 1
      },
      "feedback": {
        "hint": "One growing linearized mode is enough to make the equilibrium unstable.",
        "solution": "The positive eigenvalue creates a locally growing perturbation, so the equilibrium is unstable. This does not by itself specify the global trajectory.",
        "lesson_ids": [
          "differential-equations-3"
        ],
        "misconception_ids": []
      },
      "visibility": "public-practice-authoring",
      "provenance": {
        "kind": "legacy-prototype",
        "legacy_id": "differential-equations-3:check",
        "modifications": []
      }
