      "id": "signals-control-3:check",
      "type": "single_choice",
      "prompt": "In negative unity feedback, what is the closed-loop transfer function from reference to output?",
      "options": [
        "G/(1−G)",
        "G/(1+G)",
        "1/G",
        "1+G"
      ],
      "points": 1,
      "objective_ids": [
        "signals-control-3-objective-1"
      ],
      "solution_spec": {
        "answer": 1
      },
      "feedback": {
        "hint": "Write the error as reference minus output and solve the loop equation.",
        "solution": "With y=Ge and e=r−y, y=G(r−y), so y/r=G/(1+G).",
