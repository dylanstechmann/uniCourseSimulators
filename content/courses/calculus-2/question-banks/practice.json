    {
      "id": "calculus-2-5:convergence",
      "type": "single_choice",
      "prompt": "A release rate falls off like 5/t μg/h for t ≥ 1 h. Is the total released over [1, ∞) finite?",
      "points": 1,
      "objective_ids": [
        "calculus-2-5-objective-3"
      ],
      "options": [
        "Yes, it equals 5 μg.",
        "No: ∫ 5/t dt = 5 ln t grows without bound, so the integral diverges even though the rate tends to zero.",
        "Yes, because the rate tends to zero.",
        "It cannot be determined."
      ],
      "solution_spec": {
        "answer": 1
      },
      "feedback": {
        "hint": "Compare with the reference integrals of 1/t and 1/t².",
        "solution": "A rate tending to zero is not enough. 1/t decays too slowly; its integral grows like ln t. Such a model cannot describe a source with finite contents over unlimited time.",
        "lesson_ids": [
          "calculus-2-5"
        ],
        "misconception_ids": [
          "rate-to-zero-implies-finite"
        ]
      },
      "visibility": "public-practice-authoring",
      "provenance": {
        "kind": "original",
        "modifications": []
      }
    },
