        "unit_required": false,
        "significant_figures": null,
        "dimensions": null
      },
      "feedback": {
        "hint": "Integrate 4x from 0 to 3; work has units N·m.",
        "solution": "W=[2x²]₀³=18 N·m=18 J.",
        "lesson_ids": [
          "calculus-2-3"
        ],
        "misconception_ids": []
      },
      "visibility": "public-practice-authoring",
      "provenance": {
