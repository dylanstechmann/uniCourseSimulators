    {
      "id": "calculus-2-6:log-approx",
      "type": "single_choice",
      "prompt": "A gene's expression rises 50%. A student reports the change as ln(1.5) ≈ 0.5. Is the approximation adequate?",
      "points": 1,
      "objective_ids": [
        "calculus-2-6-objective-3"
      ],
      "options": [
        "No, because logarithms cannot describe increases.",
        "No: ln(1.5) ≈ 0.405, so the approximation is about 23% too high; ln(1 + x) ≈ x holds only for small x.",
        "Yes, for any change below 100%.",
        "Yes, ln(1 + x) = x exactly."
      ],
      "solution_spec": {
        "answer": 1
      },
      "feedback": {
        "hint": "Compare ln(1.5) with 0.5, and recall the next Taylor term −x²/2.",
        "solution": "The next term, −x²/2 = −0.125, is large at x = 0.5. Use the exact log for fold changes of this size.",
