    {
      "id": "calculus-2-5:exact-total",
      "type": "numeric",
      "prompt": "A culture consumes glucose at q(t) = 0.5 e^(0.03t) mmol/h. Calculate the exact total consumed from t = 0 to 48 h. Enter a value and unit.",
