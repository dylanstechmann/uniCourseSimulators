        "general-chemistry-1-6-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-1-6-card-4",
      "lesson_id": "general-chemistry-1-6",
      "front": "Temperature and solubility",
      "back": "Endothermic dissolution: solubility rises with T; exothermic (most gases): falls.",
      "objective_ids": [
        "general-chemistry-1-6-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
