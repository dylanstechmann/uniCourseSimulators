        "general-chemistry-1-5-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-1-5-card-2",
      "lesson_id": "general-chemistry-1-5",
      "front": "Dilution",
      "back": "C₁V₁ = C₂V₂; make up to the final volume rather than adding the full volume of solvent.",
      "objective_ids": [
        "general-chemistry-1-5-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-1-5-card-3",
      "lesson_id": "general-chemistry-1-5",
      "front": "Serial dilution",
      "back": "Total factor is the product of step factors; random errors add in quadrature, systematic errors compound.",
      "objective_ids": [
        "general-chemistry-1-5-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-1-5-card-4",
      "lesson_id": "general-chemistry-1-5",
      "front": "Error propagation",
      "back": "For products and quotients, relative errors add in quadrature; the largest relative error dominates.",
      "objective_ids": [
        "general-chemistry-1-5-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-1-6-card-1",
      "lesson_id": "general-chemistry-1-6",
      "front": "Molecular polarity",
      "back": "Polar bonds plus asymmetric geometry give a net dipole: water polar (bent), CO₂ nonpolar (linear).",
      "objective_ids": [
        "general-chemistry-1-6-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-1-6-card-2",
      "lesson_id": "general-chemistry-1-6",
      "front": "Partition coefficient",
      "back": "K_ow = [octanol]/[water]; amount fraction in water = V_w/(V_w + K V_o).",
