      "license": "MIT OR CC-BY-4.0"
    },
    {
      "id": "general-chemistry-1-3-1",
      "lesson_id": "general-chemistry-1-4",
      "front": "Equilibrium constant K",
      "back": "The value of the reaction quotient at equilibrium for a specified temperature and standard-state convention.",
      "objective_ids": [],
      "license": "MIT OR CC-BY-4.0"
    },
    {
      "id": "general-chemistry-1-5-card-1",
      "lesson_id": "general-chemistry-1-5",
      "front": "Mass for a solution",
      "back": "m = c × V × M; divide by purity; use the hydrate molar mass if weighing a hydrate.",
