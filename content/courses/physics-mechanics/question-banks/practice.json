    {
      "id": "physics-mechanics-5:scaling-check",
      "type": "single_choice",
      "prompt": "A student's formula for the impact force at fixed stopping time predicts that doubling the drop height doubles the force. What does a scaling check show?",
      "points": 1,
      "objective_ids": [
        "physics-mechanics-5-objective-3"
      ],
      "options": [
        "Force should quadruple.",
        "Force should be independent of height.",
        "At fixed stopping time, force scales with speed, which scales with √h; doubling h should raise force by about 1.41, so the formula is likely wrong.",
        "The formula is right; force always scales with height."
      ],
      "solution_spec": {
        "answer": 2
      },
      "feedback": {
        "hint": "Write F̄ = m√(2gh)/Δt and see how it depends on h.",
        "solution": "Momentum scales with √h. Force doubling with h would be correct at fixed stopping distance, where force scales with energy; a formula must match the stated condition.",
        "lesson_ids": [
          "physics-mechanics-5"
        ],
        "misconception_ids": [
          "scaling-not-checked"
        ]
      },
      "visibility": "public-practice-authoring",
      "provenance": {
        "kind": "original",
        "modifications": []
      }
    },
    {
      "id": "physics-mechanics-5:average-vs-peak",
      "type": "single_choice",
      "prompt": "Two surfaces produce the same average stopping force, but one bottoms out near the end of compression. Which statement is correct?",
      "points": 1,
      "objective_ids": [
        "physics-mechanics-5-objective-3"
      ],
      "options": [
        "The peak force can be much higher on the surface that bottoms out, so equal averages do not imply equal loading.",
        "Bottoming out lowers the peak force.",
        "Peak force does not matter for tissue.",
        "Equal averages mean equal peaks."
      ],
      "solution_spec": {
        "answer": 0
      },
      "feedback": {
        "hint": "Average force hides how the force varies during the stop.",
        "solution": "A sudden stiffening at the end produces a spike. Damage often depends on peak force, stress and loading rate, so averages are a starting estimate, not the whole answer.",
        "lesson_ids": [
          "physics-mechanics-5"
        ],
        "misconception_ids": []
