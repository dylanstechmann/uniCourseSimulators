    {
      "id": "physics-mechanics-1:incline-acceleration",
      "type": "numeric",
      "prompt": "A 10 kg block slides without friction down a 30° incline. Calculate its acceleration along the incline using g = 9.81 m/s². Enter a value and unit.",
