      "id": "physics-mechanics-3:check",
      "type": "numeric",
      "prompt": "A 0.10 kg cart moving at 5 m/s sticks to a stationary 0.40 kg cart. What is their shared speed in m/s?",
      "points": 1,
      "objective_ids": [
        "physics-mechanics-3-objective-1"
      ],
      "solution_spec": {
        "answer": 1,
        "unit": "m/s",
        "tolerance": 0.015,
        "unit_required": false,
        "significant_figures": null,
        "dimensions": null
      },
      "feedback": {
        "hint": "Conserve momentum: m₁v₁+m₂v₂=(m₁+m₂)v_f.",
        "solution": "v_f=(0.10×5)/(0.10+0.40)=1 m/s.",
        "lesson_ids": [
          "physics-mechanics-3"
