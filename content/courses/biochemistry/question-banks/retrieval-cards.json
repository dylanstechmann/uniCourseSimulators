    {
      "id": "biochemistry-5-card-2",
      "lesson_id": "biochemistry-5",
      "front": "kcat and efficiency",
      "back": "kcat = Vmax/[E]₀ (needs active enzyme); kcat/Km is the low-substrate second-order rate constant.",
      "objective_ids": [
        "biochemistry-5-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "biochemistry-5-card-3",
      "lesson_id": "biochemistry-5",
      "front": "Inhibition fingerprints",
      "back": "Competitive: Km×α, Vmax same. Noncompetitive: Vmax/α, Km same. Uncompetitive: both ÷α.",
