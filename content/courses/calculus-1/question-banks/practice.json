        "tolerance": 11.52,
        "unit_required": false,
        "significant_figures": null,
        "dimensions": null
      },
      "feedback": {
        "hint": "Apply the chain rule: 4(3x+1)³·3, then set x = 1.",
        "solution": "dy/dx = 12(3x+1)³. At x=1 this is 12×4³ = 768.",
        "lesson_ids": [
          "calculus-1-2"
        ],
        "misconception_ids": []
      },
      "visibility": "public-practice-authoring",
