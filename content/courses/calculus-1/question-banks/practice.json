    {
      "id": "calculus-1-2:symbolic-quotient-derivative",
      "type": "symbolic",
      "prompt": "Differentiate f(x) = (x² + 1)/(x + 1). Enter a simplified expression for f′(x).",
      "points": 1,
      "objective_ids": [
        "calculus-1-2-objective-1"
      ],
      "solution_spec": {
        "expression": "(x^2 + 2*x - 1)/(x + 1)^2",
        "variables": ["x"],
        "assumptions": {
          "x": {"real": true}
        }
      },
      "feedback": {
        "hint": "Apply the quotient rule to the full numerator and denominator, then combine like terms.",
        "solution": "f′(x) = [2x(x + 1) − (x² + 1)]/(x + 1)² = (x² + 2x − 1)/(x + 1)² for x ≠ −1.",
        "lesson_ids": ["calculus-1-2"],
        "misconception_ids": ["quotient-rule-order"]
      },
      "visibility": "public-practice-authoring",
      "provenance": {
        "kind": "original",
        "modifications": ["New formative item authored to exercise rational-expression equivalence grading."]
      }
    },
    {
      "id": "calculus-1-3:check",
      "type": "numeric",
      "prompt": "A positive rectangular construct has fixed perimeter 20 cm. What side length (cm) gives the maximum area?",
      "points": 1,
      "objective_ids": [
        "calculus-1-3-objective-1"
      ],
      "solution_spec": {
        "answer": 5,
        "unit": "cm",
        "tolerance": 0.075,
        "unit_required": false,
        "significant_figures": null,
        "dimensions": null
      },
      "feedback": {
        "hint": "Let sides be x and 10−x; maximize A=x(10−x) on 0<x<10.",
        "solution": "A=10x−x², so A′=10−2x=0 at x=5 cm. This is the maximum; the square maximizes area for fixed perimeter.",
        "lesson_ids": [
          "calculus-1-3"
        ],
        "misconception_ids": []
      },
      "visibility": "public-practice-authoring",
      "provenance": {
        "kind": "legacy-prototype",
        "legacy_id": "calculus-1-3:check",
