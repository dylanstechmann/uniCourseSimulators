    {
      "id": "calculus-1-6:continuity",
      "type": "single_choice",
      "prompt": "A model sets a secretion rate to 0 below a stimulus threshold s* and to a constant k > 0 above it. Which statement is correct at s*?",
      "points": 1,
      "objective_ids": [
        "calculus-1-6-objective-1"
      ],
      "options": [
        "The function is not continuous there, because the left-hand limit is 0 and the right-hand limit is k.",
        "It is continuous because it is defined at s*.",
        "It is continuous because both pieces are constant.",
        "Continuity cannot be assessed for piecewise functions."
      ],
      "solution_spec": {
        "answer": 0
      },
      "feedback": {
        "hint": "Compare one-sided limits at the junction.",
        "solution": "Continuity at a point needs the one-sided limits to agree with each other and with the value. A jump from 0 to k breaks this, which matters for numerical solvers and for derivative-based reasoning.",
        "lesson_ids": [
          "calculus-1-6"
        ],
        "misconception_ids": []
