      "objective_ids": [
        "statics-materials-1-objective-1"
      ],
      "solution_spec": {
        "answer": 300,
        "unit": "N",
        "tolerance": 4.5,
        "unit_required": false,
        "significant_figures": null,
        "dimensions": null
      },
      "feedback": {
        "hint": "Use symmetry and vertical-force equilibrium.",
        "solution": "The reactions are equal; 2R=600 N, so R=300 N at each support.",
