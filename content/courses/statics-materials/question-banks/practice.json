    {
      "id": "statics-materials-1:reaction-force",
      "type": "numeric",
      "prompt": "A simply supported beam 4.0 m long carries a single 200 N downward load 1.0 m from the left support. Calculate the reaction at the right support. Enter a value and unit.",
      "points": 1,
      "objective_ids": [
        "statics-materials-1-objective-2"
      ],
      "solution_spec": {
        "answer": 50.0,
        "unit": "N",
        "tolerance": 0.1,
        "unit_required": true,
        "significant_figures": null,
        "dimensions": null
      },
      "feedback": {
        "hint": "Take moments about the left support.",
        "solution": "Moments about the left support: R_right × 4.0 = 200 × 1.0, so R_right = 50 N and R_left = 150 N by force balance.",
        "lesson_ids": [
          "statics-materials-1"
        ],
        "misconception_ids": []
      },
      "visibility": "public-practice-authoring",
      "provenance": {
        "kind": "original",
