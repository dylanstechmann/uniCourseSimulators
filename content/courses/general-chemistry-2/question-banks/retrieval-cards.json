        "general-chemistry-2-14-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-14-card-3",
      "lesson_id": "general-chemistry-2-14",
      "front": "Ligand condition",
      "back": "Fixed free ligand and a closed analytical ligand total are different boundary conditions.",
