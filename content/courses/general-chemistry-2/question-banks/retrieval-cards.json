  "cards": [
    {
      "id": "general-chemistry-2-0-0",
      "lesson_id": "general-chemistry-2-1",
      "front": "Buffer capacity",
      "back": "The amount of strong acid or base a solution can absorb per pH change.",
      "objective_ids": [],
      "license": "MIT OR CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-0-1",
      "lesson_id": "general-chemistry-2-1",
      "front": "pKa",
      "back": "−log₁₀ Ka; a useful reference point where conjugate acid and base concentrations are equal in an ideal buffer.",
      "objective_ids": [],
      "license": "MIT OR CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-1-0",
      "lesson_id": "general-chemistry-2-2",
      "front": "Rate-determining step",
      "back": "A mechanistic step that constrains the overall reaction rate under specified conditions.",
      "objective_ids": [],
      "license": "MIT OR CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-1-1",
      "lesson_id": "general-chemistry-2-2",
      "front": "Activation energy Ea",
      "back": "The energy barrier parameter that governs the temperature sensitivity of a rate constant in Arrhenius behavior.",
      "objective_ids": [],
      "license": "MIT OR CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-2-0",
      "lesson_id": "general-chemistry-2-3",
      "front": "Cathode",
      "back": "The electrode at which reduction occurs.",
      "objective_ids": [],
      "license": "MIT OR CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-2-1",
      "lesson_id": "general-chemistry-2-3",
      "front": "Nernst equation",
      "back": "A relation that adjusts electrode potential for nonstandard activities and temperature.",
      "objective_ids": [],
      "license": "MIT OR CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-3-0",
      "lesson_id": "general-chemistry-2-4",
      "front": "Coordination number",
      "back": "The number of donor atoms directly bonded to a central metal in a complex.",
      "objective_ids": [],
      "license": "MIT OR CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-3-1",
      "lesson_id": "general-chemistry-2-4",
      "front": "Bioavailability",
      "back": "The fraction of an element present in a form accessible for uptake or biochemical use.",
      "objective_ids": [],
      "license": "MIT OR CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-5-card-1",
      "lesson_id": "general-chemistry-2-5",
      "front": "Henderson–Hasselbalch",
      "back": "pH = pKa + log₁₀([A⁻]/[HA]); valid when buffer concentrations ≫ [H⁺], using concentrations as activities.",
      "objective_ids": [
        "general-chemistry-2-5-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-5-card-2",
      "lesson_id": "general-chemistry-2-5",
      "front": "Buffer range",
      "back": "Buffers work best within about ±1 pH unit of pKa.",
      "objective_ids": [
        "general-chemistry-2-5-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-5-card-3",
      "lesson_id": "general-chemistry-2-5",
      "front": "Buffer capacity",
      "back": "β = 2.303 C_T Ka[H⁺]/(Ka + [H⁺])²: proportional to C_T and maximal at pH = pKa.",
      "objective_ids": [
        "general-chemistry-2-5-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-5-card-4",
      "lesson_id": "general-chemistry-2-5",
      "front": "Ionized fraction",
      "back": "Weak base un-ionized fraction = 1/(1 + 10^(pKa − pH)); charged forms cross membranes poorly.",
      "objective_ids": [
        "general-chemistry-2-5-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-6-card-1",
      "lesson_id": "general-chemistry-2-6",
      "front": "First order",
      "back": "[A] = [A]₀e^(−kt); t½ = ln 2/k, independent of starting concentration; ln[A] vs t is linear.",
      "objective_ids": [
        "general-chemistry-2-6-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-6-card-2",
      "lesson_id": "general-chemistry-2-6",
      "front": "Second order",
      "back": "1/[B] = 1/[B]₀ + kt; t½ = 1/(k[B]₀) grows as concentration falls.",
      "objective_ids": [
        "general-chemistry-2-6-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-6-card-3",
      "lesson_id": "general-chemistry-2-6",
      "front": "Arrhenius",
      "back": "ln(k₂/k₁) = (Ea/R)(1/T₁ − 1/T₂); Q₁₀ summarizes the rise per 10 °C but depends on the range.",
      "objective_ids": [
        "general-chemistry-2-6-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-6-card-4",
      "lesson_id": "general-chemistry-2-6",
      "front": "Extrapolation risk",
      "back": "Accelerated tests assume one mechanism across temperatures; unfolding or new pathways break it.",
      "objective_ids": [
        "general-chemistry-2-6-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-7-card-1",
      "lesson_id": "general-chemistry-2-7",
      "front": "Nernst equation",
      "back": "E = E°′ + (2.303RT/nF) log([Ox]/[Red]); ≈ 62/n mV per decade at 37 °C.",
      "objective_ids": [
        "general-chemistry-2-7-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-7-card-2",
      "lesson_id": "general-chemistry-2-7",
      "front": "Direction and energy",
      "back": "Electrons flow to the higher actual potential; ΔG = −nFΔE.",
      "objective_ids": [
        "general-chemistry-2-7-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-7-card-3",
      "lesson_id": "general-chemistry-2-7",
      "front": "Coordination",
      "back": "Coordination number and geometry (tetrahedral, square planar, octahedral) and ligands tune a metal's function and potential.",
      "objective_ids": [
        "general-chemistry-2-7-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-7-card-4",
      "lesson_id": "general-chemistry-2-7",
      "front": "Chelation",
      "back": "Multidentate ligands like EDTA bind strongly; free metal = [complex]/(K_f [free ligand]).",
      "objective_ids": [
        "general-chemistry-2-7-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-8-card-1",
      "lesson_id": "general-chemistry-2-8",
      "front": "Standard versus current",
      "back": "ΔG=ΔG°+RT ln Q; current composition can reverse a direction favored in the standard comparison.",
      "objective_ids": [
        "general-chemistry-2-8-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-8-card-2",
      "lesson_id": "general-chemistry-2-8",
      "front": "Equilibrium constant",
      "back": "ΔG°=−RT ln K uses a dimensionless K and matching reaction/temperature conventions.",
      "objective_ids": [
        "general-chemistry-2-8-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-8-card-3",
      "lesson_id": "general-chemistry-2-8",
      "front": "Coupling",
      "back": "Compatible reaction free energies add and their constants multiply; an equation sum alone does not establish physical coupling.",
      "objective_ids": [
        "general-chemistry-2-8-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-8-card-4",
      "lesson_id": "general-chemistry-2-8",
      "front": "Direction and rate",
      "back": "A thermodynamic sign supplies no reaction time scale; useful-work bounds do not establish operating efficiency.",
      "objective_ids": [
        "general-chemistry-2-8-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-9-card-1",
      "lesson_id": "general-chemistry-2-9",
      "front": "Diprotic fractions",
      "back": "Normalize h²,K₁h,K₁K₂ by their sum for neutral, singly and doubly deprotonated forms.",
      "objective_ids": [
        "general-chemistry-2-9-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-9-card-2",
      "lesson_id": "general-chemistry-2-9",
      "front": "Charge weights",
      "back": "HA⁻ counts once and A²⁻ twice in negative charge, while each counts once in family mass balance.",
      "objective_ids": [
        "general-chemistry-2-9-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-9-card-3",
      "lesson_id": "general-chemistry-2-9",
      "front": "Imposed versus solved",
      "back": "Given h determines fractions; predicting closed-solution h also requires compatible charge and analytical balances.",
      "objective_ids": [
        "general-chemistry-2-9-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-9-card-4",
      "lesson_id": "general-chemistry-2-9",
      "front": "Approximation check",
      "back": "Dominant-form and amphiprotic shortcuts require scale and concentration checks, not just a species name.",
      "objective_ids": [
        "general-chemistry-2-9-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-10-card-1",
      "lesson_id": "general-chemistry-2-10",
      "front": "Empirical powers",
      "back": "Controlled initial-rate ratios determine empirical orders; overall coefficients alone do not.",
      "objective_ids": [
        "general-chemistry-2-10-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-10-card-2",
      "lesson_id": "general-chemistry-2-10",
      "front": "Elementary model",
      "back": "Elementary mass action and justified pre-equilibrium/steady-state assumptions can predict a mechanism rate law.",
      "objective_ids": [
        "general-chemistry-2-10-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-10-card-3",
      "lesson_id": "general-chemistry-2-10",
      "front": "Pseudo-first-order",
      "back": "A nearly constant excess reactant can hide a concentration dependence in an apparent first-order constant.",
      "objective_ids": [
        "general-chemistry-2-10-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-10-card-4",
      "lesson_id": "general-chemistry-2-10",
      "front": "Mechanism compatibility",
      "back": "Matching a rate law can make a mechanism compatible without uniquely identifying it.",
      "objective_ids": [
        "general-chemistry-2-10-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-11-card-1",
      "lesson_id": "general-chemistry-2-11",
      "front": "Relaxation",
      "back": "For closed first-order A⇌B, λ=k_f+k_r and A−A_eq decays exponentially.",
      "objective_ids": [
        "general-chemistry-2-11-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-11-card-2",
      "lesson_id": "general-chemistry-2-11",
      "front": "Half-life definition",
      "back": "Displacement half-life differs from time to half the initial A when a nonzero equilibrium plateau exists.",
