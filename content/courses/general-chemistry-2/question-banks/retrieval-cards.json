        "general-chemistry-2-13-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-14-card-1",
      "lesson_id": "general-chemistry-2-14",
      "front": "Saturation",
      "back": "Apply the matching free-ion product at saturation while the specified solid remains available.",
