        "general-chemistry-2-12-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-12-card-3",
      "lesson_id": "general-chemistry-2-12",
      "front": "Charge amount",
      "back": "q=It and q/(nF) give reaction amount when all charge serves the specified reaction.",
      "objective_ids": [
        "general-chemistry-2-12-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-12-card-4",
      "lesson_id": "general-chemistry-2-12",
      "front": "Current efficiency",
      "back": "Target current efficiency partitions charge; it is different from energy efficiency and product recovery.",
      "objective_ids": [
        "general-chemistry-2-12-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-13-card-1",
      "lesson_id": "general-chemistry-2-13",
      "front": "Coordination count",
      "back": "Count directly bound donor atoms; denticity, ionic charge and oxidation state are different quantities.",
      "objective_ids": [
        "general-chemistry-2-13-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-13-card-2",
      "lesson_id": "general-chemistry-2-13",
      "front": "Closed ligand balance",
      "back": "For M+L⇌ML, complex formation subtracts the same amount from both free-species totals.",
      "objective_ids": [
        "general-chemistry-2-13-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-13-card-3",
      "lesson_id": "general-chemistry-2-13",
      "front": "Octahedral d⁶",
      "back": "Limited high-spin and low-spin occupations have different unpaired counts and crystal-field/pairing energies.",
      "objective_ids": [
        "general-chemistry-2-13-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-13-card-4",
      "lesson_id": "general-chemistry-2-13",
      "front": "Model evidence",
      "back": "An equilibrium constant does not supply exchange speed, and a donor count alone does not identify geometry.",
