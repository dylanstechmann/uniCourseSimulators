        "general-chemistry-2-11-objective-2"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-11-card-3",
      "lesson_id": "general-chemistry-2-11",
      "front": "Directional constants",
      "back": "Independent equilibrium ratio and relaxation sum together partition the constants under the specified two-state model.",
