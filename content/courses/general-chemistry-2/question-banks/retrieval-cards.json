        "general-chemistry-2-14-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-14-card-4",
      "lesson_id": "general-chemistry-2-14",
      "front": "Selectivity limits",
      "back": "Saturation onset and a threshold interval do not establish complete separation, kinetics or recovered purity.",
