        "general-chemistry-2-11-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-11-card-4",
      "lesson_id": "general-chemistry-2-11",
      "front": "Observation scope",
      "back": "A reporting background, equilibrium plateau and sequential intermediate are distinct sources of nonzero signals.",
      "objective_ids": [
        "general-chemistry-2-11-objective-3"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-12-card-1",
      "lesson_id": "general-chemistry-2-12",
      "front": "Cell convention",
      "back": "Subtract anode reduction potential from cathode reduction potential for the written forward cell.",
      "objective_ids": [
        "general-chemistry-2-12-objective-1"
      ],
      "license": "CC-BY-4.0"
    },
    {
      "id": "general-chemistry-2-12-card-2",
      "lesson_id": "general-chemistry-2-12",
      "front": "Equation scaling",
      "back": "Doubling n and ΔG leaves E unchanged; Q and K powers scale with the equation.",
